      [
        10,
        "transition_s",
        "转场多长（秒）",
        "默认 0.6；比最短那一段的一半还长时自动缩短"
      ],
      [
        10,
        "ratio",
        "成片画面比例",
        "默认跟第一段；想统一成竖屏短视频选 9:16 竖屏，各段不一样大时会留黑边（或按下面的设置裁掉多余的）"
      ],
      [
        10,
        "keep_audio",
        "保留各段的声音",
